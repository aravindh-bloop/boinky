# ── Server ────────────────────────────────────────────────
PORT=4000
NODE_ENV=development
LOG_LEVEL=debug
# Comma-separated list of allowed origins for CORS (dashboard, etc). * allows all.
CORS_ORIGINS=*

# ── Auth ──────────────────────────────────────────────────
# Any long random string. Used to sign JWTs.
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=30d

# ── Database (Neon Postgres) ──────────────────────────────
# From https://console.neon.tech → project → Connection string (pooled is fine).
DATABASE_URL=postgres://user:password@ep-xxx.region.aws.neon.tech/agripod?uselibpqcompat=true&sslmode=require

# ── Gemini (Google AI Studio) — image → disease/pest diagnosis ──
# From https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

# ── Sarvam AI — language detection + multilingual advisory ──
# From https://dashboard.sarvam.ai/
SARVAM_API_KEY=

# ── Cloudinary — scan image storage ───────────────────────
# From https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Open-Meteo — weather / risk inputs (no key needed) ─────
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1

# ── Risk / escalation tuning ──────────────────────────────
# Scans with model confidence below this get flagged for expert validation.
CONFIDENCE_ESCALATION_THRESHOLD=0.65
