{
  "name": "agripod-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "AgriPod backend — crop disease/pest detection & management API",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "migrate": "node-pg-migrate up -m migrations --envPath .env",
    "migrate:up": "node-pg-migrate up -m migrations --envPath .env",
    "migrate:down": "node-pg-migrate down -m migrations --envPath .env",
    "migrate:redo": "node-pg-migrate redo -m migrations --envPath .env",
    "migrate:deploy": "node-pg-migrate up -m migrations",
    "migrate:create": "node-pg-migrate create -j sql -m migrations",
    "seed": "tsx src/db/seed.ts",
    "seed:dev": "tsx src/db/dev-seed.ts",
    "seed:demo": "tsx src/db/demo-seed.ts",
    "i18n:prewarm": "tsx src/db/i18n-prewarm.ts",
    "db:reset": "npm run migrate:up && npm run seed && npm run seed:dev"
  },
  "dependencies": {
    "@google/genai": "^2.19.0",
    "bcryptjs": "^3.0.3",
    "cloudinary": "^2.11.0",
    "cors": "^2.8.6",
    "csv-parse": "^7.0.2",
    "dotenv": "^16.6.1",
    "express": "^4.22.2",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.2.0",
    "pg": "^8.23.0",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0",
    "sharp": "^0.35.4",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^1.4.13",
    "@types/node": "^22.20.1",
    "@types/pg": "^8.23.1",
    "node-pg-migrate": "^9.0.0",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3"
  }
}
